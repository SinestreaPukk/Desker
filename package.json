{
  "name": "desker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:schema": "node scripts/db/gen-schema.mjs",
    "db:generate": "npm run db:schema && node scripts/db/prisma.mjs generate",
    "db:push": "npm run db:schema && npm run db:backfill && node scripts/db/prisma.mjs db push && npm run db:migrate-data",
    "db:migrate": "npm run db:schema && node scripts/db/prisma.mjs migrate dev",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "node scripts/db/prisma.mjs studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check:contrast": "node scripts/ops/check-contrast.mjs",
    "verify": "npm run check:dupes && npm run typecheck && npm run lint && npm run check:contrast && npm test",
    "db:backfill": "node scripts/db/backfill-projects.mjs",
    "db:migrate-data": "node scripts/db/migrate-data.mjs",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "deploy:build": "npm run db:generate && npm run db:backfill && npm run db:deploy && npm run db:migrate-data && next build",
    "vercel-build": "npm run deploy:build",
    "db:deploy": "node scripts/db/db-deploy.mjs",
    "check:security": "node scripts/ops/security-check.mjs",
    "check:dupes": "sh -c 'f=$(find src content scripts tests prisma public -name \"* [0-9].*\" -type f); if [ -n \"$f\" ]; then echo \"Duplicate (cloud-sync) files found:\"; echo \"$f\"; exit 1; fi'",
    "line:richmenu": "NODE_OPTIONS=\"--conditions=react-server --import ./scripts/load-env.mjs\" npx tsx scripts/ops/line-richmenu.mts"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.75.0",
    "@tanstack/react-query": "^5.90.2",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "inngest": "^4.20.0",
    "lucide-react": "^0.545.0",
    "mammoth": "^1.11.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.29",
    "openai": "^6.2.0",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
