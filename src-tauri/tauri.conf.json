{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desker",
  "version": "0.1.0",
  "identifier": "app.desker.desktop",
  "build": {
    "frontendDist": "../src-tauri/shell",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Desker",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Agentic AI Platform",
    "longDescription": "Build AI employees with a role, a personality and your company's context, then put them in front of real clients."
  }
}
