// ---------------------------------------------------------------------------
// SOURCE OF TRUTH for the Prisma schema.
//
// Do not edit prisma/schema.prisma directly - it is generated from this file by
// scripts/gen-schema.mjs so that the same model set can target either
// PostgreSQL + pgvector (server / cloud) or SQLite (single-user desktop demo).
//
// Blocks between `//#IF <provider>` and `//#ENDIF` are kept only for that
// provider and stripped for every other one.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
//#IF postgresql
  previewFeatures = ["postgresqlExtensions"]
//#ENDIF
}

datasource db {
  provider = "__PROVIDER__"
  url      = env("DATABASE_URL")
//#IF postgresql
  extensions = [vector]
//#ENDIF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// "First Last", composed from the two below at sign-up; what the product shows.
  name         String?
  firstName    String?
  lastName     String?
  /// Chosen at sign-up; lowercase letters, numbers, dots, dashes, underscores.
  username     String?  @unique
  /// When the password last changed. Sessions signed in before it are ended.
  passwordChangedAt DateTime?
  /// Devices this person has signed in from (a hash of browser and system,
  /// never an IP), so a sign-in from a new one can be emailed to them.
  knownDevices Json?
  /// When and which version of the Terms and Privacy Policy this person
  /// accepted at sign-up. The acceptance record the legal documents need.
  termsAcceptedAt DateTime?
  termsVersion    String?
  /// What Desker messages this person about, and when: see lib/messaging/prefs.ts.
  alertPrefs   Json?
  /// When their last morning brief went out, so one goes out per day.
  lastBriefAt  DateTime?
  /// When their weekly cross-domain digest last went out (lib/life/digest.ts).
  lastLifeDigestAt DateTime?
  createdAt    DateTime @default(now())

  memberships Membership[]
  messageChannels MessageChannel[]
  feedback    Feedback[]
  passwordResets PasswordReset[]
}

/// What a watched social account looked like when an agent last checked -
/// followers, recent posts - so the next check can say what changed.
model SocialSnapshot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// "instagram:@handle"
  key            String
  data           Json
  takenAt        DateTime     @default(now())

  @@index([organizationId, key, takenAt])
}

/// Somewhere Desker messages a person: a chat app they linked (LINE,
/// Telegram, WhatsApp), a webhook they pasted (Slack, Discord, Teams), or
/// their account email.
model MessageChannel {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// line | telegram | whatsapp | email | slack | discord | teams
  kind      String
  /// Vault ciphertext of where to send: a chat id, a phone number, a webhook
  /// URL. Null until a chat app is linked.
  target    String?
  /// A hash of kind + chat id, to recognise who an incoming message is from.
  senderKey String?  @unique
  /// What the person sees in their list.
  label     String
  /// The code they send from the app to link it. Cleared once linked.
  linkCode  String?  @unique
  enabled   Boolean  @default(true)
  /// Why the last message didn't arrive, until one does.
  lastError String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A "forgot password" link. Only a hash of the token is stored, so a copy of
/// the database cannot be used to reset anyone's password. One use, one hour.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// What a person told us from inside the product. Read by the team, never by
/// an agent; forwarded to the notification webhook when one is configured.
model Feedback {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// bug | idea | question | other
  kind           String   @default("other")
  message        String
  /// Where they were when they sent it.
  path           String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

/// Lightweight product analytics: which screens and actions people actually
/// use. One row per event; no third party sees it. Decides what gets built.
model ProductEvent {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  /// page.viewed, agent.published, approval.decided, ...
  name           String
  path           String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([name, createdAt])
}

// ---------------------------------------------------------------------------
// Tenancy. Every row an admin can see hangs off an Organization, either
// directly or through its Project. A user reaches an organisation only through
// a Membership, so "which org am I in" is always a join, never a cookie.
// ---------------------------------------------------------------------------

/// The billing and access boundary. One is created for every new account at
/// sign-up; invites and the org switcher arrive later, the model does not
/// change for them.
model Organization {
  id        String   @id @default(cuid())
  name      String
  /// URL-safe handle, reserved for when organisations get their own segment.
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  projects      Project[]
  actionItems   ActionItem[]
  auditLogs     AuditLog[]
  usageCounters UsageCounter[]
  drafts        Draft[]
  integrations  Integration[]
  digests       Digest[]
  projectCheckIns ProjectCheckIn[]
  suggestions   Suggestion[]
  emailSuppressions EmailSuppression[]
  socialSnapshots   SocialSnapshot[]
}

/// Someone who asked not to receive email from this organisation, through the
/// unsubscribe link at the foot of every agent and digest email. Checked
/// before each send; never removed by the product.
model EmailSuppression {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
}

/// user <-> organisation, with a role. A user may belong to several.
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner | admin | member
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// A workspace inside an organisation, with its own roster, inbox and
/// insights. Everything an admin sees is scoped to exactly one of these.
model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// URL segment. Stable, so bookmarks survive a rename of the display name.
  /// Globally unique for now because the URL carries no organisation segment;
  /// uniqueSlug() appends a counter across organisations.
  slug           String       @unique
  /// Shared context every agent in the project inherits: what the company
  /// does, who it is for, how it should sound. Typed once here instead of
  /// three times across three agents.
  ///
  /// `context` is the composed string a prompt reads; `contextAnswers` is the
  /// guided-question form behind it ({ questionId: answer }). The string is
  /// derived from the answers on every save - see lib/work/context.ts.
  context        String       @default("")
  contextAnswers Json?
  /// Project-wide owner check-in preferences. Null inherits the former per-agent defaults.
  checkInCadence    String?
  checkInTimezone   String?
  checkInEmail      Boolean?
  checkInRecipients String?
  lastCheckInAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  agents       Agent[]
  teamThreads  TeamThread[]
  teamMessages TeamMessage[]
  checkIns     ProjectCheckIn[]
  lifeEvents   LifeEvent[]
  lifeEntries  LifeEntry[]
  lifeTasks    LifeTask[]
  lifeGoals    LifeGoal[]
  lifeWorkouts LifeWorkout[]
  lifePrefs    LifePreference[]
  lifeNotes    LifeNote[]
  lifeAlerts   LifeAlertSent[]

  @@index([organizationId])
}

model Agent {
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id               String   @id @default(cuid())
  name             String
  jobTitle         String
  department       String?
  /// The role template it was hired from (content/templates.json), so
  /// Insights can say which roles are used and how they do. Null for agents
  /// started from scratch, or hired before this was recorded.
  templateId       String?
  avatarUrl        String?
  // Free text, injected verbatim into the system prompt.
  personality      String
  // string[] - see lib/agent-fields.ts for the (de)serialisation helpers.
  responsibilities Json
  // string[] - subset of the fixed tool set in lib/tools/registry.ts.
  allowedTools     Json
  escalationRule   String?
  welcomeMessage   String?
  status           String   @default("draft") // draft | published
  modelProvider    String   @default("anthropic")
  model            String?  // null -> provider default
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  documents           Document[]
  conversations       Conversation[] @relation("ConversationOwner")
  activeConversations Conversation[] @relation("ConversationActive")
  retrievalLogs       RetrievalLog[]
  actionItems         ActionItem[]
  scopeOfWork         ScopeOfWork?
  drafts              Draft[]
  issues              Issue[]
  digests             Digest[]
  suggestions         Suggestion[]
  teamMessages        TeamMessage[]
  rules               AgentRule[]

  @@index([status])
  @@index([projectId])
}

/// A correction the owner chose to keep: saved from a rejected or edited
/// draft (or typed by hand), and read by the agent before everything it does
/// from then on. Always visible and editable on the agent's page, and every
/// change is an audit row - never a silent, growing pile of behaviour.
model AgentRule {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  text         String
  /// rejection | edit | manual
  source       String   @default("manual")
  /// The run whose draft was corrected, when it came from one.
  actionItemId String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agentId, createdAt])
}

model Document {
  id         String   @id @default(cuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  storageKey String
  sizeBytes  Int      @default(0)
  status     String   @default("pending") // pending | ready | failed
  error      String?
  chunkCount Int      @default(0)
  createdAt  DateTime @default(now())

  chunks DocumentChunk[]

  @@index([agentId])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Denormalised so retrieval can filter by agent without a join.
  agentId    String
  content    String
  chunkIndex Int
  // Canonical embedding storage: JSON array of floats. Works on every provider
  // and is what the in-process cosine retriever reads.
  embeddingJson String?
//#IF postgresql
  // Mirror of embeddingJson maintained via raw SQL (Prisma Client cannot write
  // Unsupported columns). Used by the pgvector ANN retriever.
  embedding  Unsupported("vector(1536)")?
//#ENDIF

  @@index([documentId])
  @@index([agentId])
}

model Conversation {
  id              String   @id @default(cuid())
  agentId         String
  agent           Agent    @relation("ConversationOwner", fields: [agentId], references: [id], onDelete: Cascade)
  clientSessionId String
  status          String   @default("open") // open | escalated | resolved
  // agent: the AI answers. human: a colleague has taken over and the AI stays
  // quiet until they hand it back.
  //
  // Not called `mode`: that is the name of a Postgres ordered-set aggregate, and
  // a query referencing it fails with "WITHIN GROUP is required".
  replyMode       String   @default("agent") // agent | human
  takenOverBy     String?
  takenOverAt     DateTime?
  // Rolling summary, refreshed in the background. Powers the inbox preview and
  // the recall a returning client gets.
  summary         String?
  summarizedAt    DateTime?
  // Who is handling the conversation now. `agentId` stays the agent the client
  // actually contacted - it is half the unique key, and the client's chat link
  // points at it - so a transfer moves this instead. Null means nobody has
  // transferred and the original agent is still answering.
  activeAgentId   String?
  // SetNull rather than Cascade: deleting the colleague a conversation was
  // transferred to must not delete the conversation, it must hand it back.
  activeAgent     Agent?   @relation("ConversationActive", fields: [activeAgentId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  lastMessageAt   DateTime @default(now())

  messages Message[]
  issues   Issue[]
  notes    ConversationNote[]

  @@unique([agentId, clientSessionId])
  @@index([agentId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([clientSessionId])
  @@index([activeAgentId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // human is a colleague typing from the inbox; it reaches the client's chat
  // exactly like an assistant turn, and is never replayed to the model as one.
  role           String       // user | assistant | tool | human
  // Display name for a human turn, so the transcript says who answered.
  authorName     String?
  // Plain-text rendering, safe to show in the admin transcript.
  content        String
  // Raw provider content blocks, kept so a conversation can be replayed to the
  // model with tool_use / tool_result pairs intact.
  blocks         Json?
  // Client feedback on an assistant or human reply: 1 (helpful) or -1 (not).
  // The dislikes are the useful half - they are the answers to go and fix.
  rating         Int?
  ratedAt        DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([rating])
}

/// A private note an admin leaves on a conversation. Never shown to the
/// client, never replayed to the model - context for the next person who
/// opens it.
model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorName     String
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// One `search_documents` call. Kept so an admin can see which questions
/// the uploaded documents fail to answer - the list of things worth writing
/// down next.
model RetrievalLog {
  id             String   @id @default(cuid())
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversationId String?
  query          String
  hitCount       Int
  createdAt      DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([agentId, hitCount])
}

/// Something raised for a person's attention. Two sources: a client, via a
/// conversation (issue, suggestion, escalation), or the agent itself, via an
/// autonomous run (an escalation rule that fired, a run that failed, a
/// request it did not know how to handle). `agentId` is denormalised so the
/// inbox can list both kinds per agent without a join through either parent.
model Issue {
  id             String        @id @default(cuid())
  agentId        String
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actionItemId   String?
  actionItem     ActionItem?   @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  /// client | agent
  source         String        @default("client")
  type           String        // issue | suggestion | escalation | failure
  summary        String
  severity       String?       // low | medium | high | critical
  details        String?
  status         String        @default("open") // open | resolved
  createdAt      DateTime      @default(now())

  @@index([status])
  @@index([agentId, status])
  @@index([conversationId])
  @@index([actionItemId])
}

// ---------------------------------------------------------------------------
// Autonomous work, oversight and metering. Mostly empty until the work engine
// lands; the shapes exist now so nothing above them has to be re-plumbed.
// ---------------------------------------------------------------------------

/// What an agent is for when nobody is talking to it: the standing brief the
/// autonomous work loop runs against. One per agent. The trigger decides when
/// a run starts - a cron cadence, an inbound webhook, or only by hand.
model ScopeOfWork {
  id             String   @id @default(cuid())
  agentId        String   @unique
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// What this agent reads before every run, on top of the project's shared
  /// context. Composed from `contextAnswers` (the guided questions in the
  /// editor) so that everything downstream - the prompt, retrieval, the tool
  /// loop - keeps reading one plain string.
  context        String   @default("")
  /// { questionId: answer } for the guided context questions. Null on a scope
  /// written before the questions existed; its `context` is then offered as
  /// the answer to the first question.
  contextAnswers Json?
  /// string[] - what a run should achieve. Injected into the prompt verbatim.
  objectives     Json
  /// string[] of Document ids the agent may search during a run. Empty means
  /// every ready document the agent has.
  documentIds    Json
  /// manual | cron | webhook
  triggerType    String   @default("manual")
  /// Five-field cron expression, evaluated in `timezone`. Set when triggerType is cron.
  cron           String?
  timezone       String   @default("UTC")
  /// Secret path segment of the inbound webhook URL. Set when triggerType is webhook.
  webhookToken   String?  @unique
  enabled        Boolean  @default(true)
  /// draft_only: external tools (publish, email) stop for approval.
  /// auto: they go straight out. Every agent starts draft_only.
  autonomy       String   @default("draft_only")
  /// Per-tool overrides: { publish_post?: "draft_only" | "auto", send_email?: ... }.
  /// A tool not listed inherits `autonomy`.
  toolAutonomy   Json?
  /// string[] of work tool ids the agent may use during a run. Null means
  /// every tool. Set by the role template, trimmed in the editor.
  tools          Json?
  /// The last cron fire time that produced a run, so a tick is never doubled.
  lastFiredAt    DateTime?
  /// How often the agent reports on itself: off | daily | weekly. The digest
  /// rolls up recent run summaries into one short update. Weekly by default,
  /// because an agent nobody hears from is a tool, not a colleague.
  digestCadence  String   @default("weekly")
  /// Also send the digest by email, not just to the Inbox's Updates tab.
  digestEmail    Boolean  @default(false)
  /// Comma-separated addresses. Null means the organisation's owners and admins.
  digestRecipients String?
  /// The last digest period that was generated, so a tick is never doubled.
  lastDigestAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([triggerType, enabled])
}

/// One unit of work an agent performs on its own - a research run, a draft, a
/// send. The state machine:
///
///   queued -> in_progress -> done | failed | needs_approval
///   needs_approval -> approved -> executing_external -> done | failed
///   needs_approval -> rejected
///
/// `organizationId` is denormalised so approvals and billing can be listed per
/// tenant without a join through the agent.
model ActionItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status         String       @default("queued")
  /// What kind of run this is: scope_run (the agent's brief), followup (queued
  /// by an earlier run), or the name of the external tool awaiting approval.
  type           String
  /// schedule | webhook | manual | followup
  trigger        String       @default("manual")
  /// What started it: the webhook body, the follow-up objective, the cron tick.
  payload        Json
  /// What it produced: findings, the agent's own report, ids of drafts written.
  result         Json?
  /// The plain-language account a person reads first: what it did, what it
  /// found, what it thinks should happen next. Three or four sentences,
  /// written for the owner. `result.summary` keeps the raw report next to it.
  summary        String?
  /// One line for a list row, under 80 characters.
  headline       String?
  /// The external call waiting for a human: { tool, input, draftId? }.
  pendingAction  Json?
  /// Every tool call in order, truncated, for the audit view and debugging.
  steps          Json?
  error          String?
  /// `${scopeId}:${fireTime}` for scheduled runs, so a tick never doubles.
  dedupeKey      String?      @unique
  /// A follow-up's parent run.
  parentId       String?
  parent         ActionItem?  @relation("ActionItemFollowups", fields: [parentId], references: [id], onDelete: SetNull)
  followups      ActionItem[] @relation("ActionItemFollowups")
  /// When a follow-up should start. Null means immediately.
  scheduledFor   DateTime?
  /// When it entered needs_approval; approval turnaround is measured from here.
  awaitingSince  DateTime?
  approvedById   String?
  approvedAt     DateTime?
  /// Set when the agent's escalation rule fired during the run.
  escalatedAt    DateTime?
  escalationReason String?
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  drafts      Draft[]
  issues      Issue[]
  suggestions Suggestion[]
  teamMessages TeamMessage[]

  @@index([organizationId, status])
  @@index([agentId, status])
  @@index([createdAt])
}

/// The agent reporting on itself without being asked: one roll-up per agent
/// per period, synthesised from the run summaries in that window plus what is
/// still waiting on a person. Generated by a scheduled function, read in the
/// Inbox's Updates tab, and optionally emailed.
///
/// `organizationId` is denormalised so the tab can list a tenant's digests
/// without a join through the agent, the same way ActionItem does.
model Digest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// daily | weekly. Copied from the scope at generation time, so a digest
  /// still reads correctly after the cadence is changed.
  cadence        String
  /// The window it covers. `periodStart` is also the dedupe key.
  periodStart    DateTime
  periodEnd      DateTime
  /// One line: what this period amounted to.
  headline       String
  /// { kind: "done" | "pending" | "heads_up", text: string }[] - capped at a
  /// handful, ordered by what changed or what needs a decision.
  bullets        Json
  /// { runs, completed, failed, awaitingApproval, drafts, suggestions }.
  stats          Json
  /// Action item ids the digest covers, for "see the runs behind this".
  actionItemIds  Json
  readAt         DateTime?
  emailedAt      DateTime?
  /// Why the email did not go out, when it was asked for and failed.
  emailError     String?
  createdAt      DateTime     @default(now())

  @@unique([agentId, periodStart])
  @@index([organizationId, createdAt])
  @@index([agentId, createdAt])
}

/// One daily or weekly check-in for the whole project, with links back to its work.
model ProjectCheckIn {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cadence        String
  periodStart    DateTime
  periodEnd      DateTime
  headline       String
  bullets        Json
  stats          Json
  /// Current health for each agent, saved to report changes next period.
  agentHealth    Json
  actionItemIds  Json
  suggestionIds  Json
  readAt         DateTime?
  emailedAt      DateTime?
  emailError     String?
  createdAt      DateTime     @default(now())

  @@index([projectId, periodStart])
  @@index([organizationId, createdAt])
}

/// An agent-initiated recommendation, kept distinct from a task result: what
/// it noticed, why that matters, and the next step it proposes. An owner
/// accepts it (the proposal becomes an objective on the agent's scope of
/// work), dismisses it, or snoozes it until later. Shown in the Inbox's
/// Issues & suggestions tab alongside Issue rows.
model Suggestion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// The run that raised it, when there was one.
  actionItemId   String?
  actionItem     ActionItem?  @relation(fields: [actionItemId], references: [id], onDelete: SetNull)
  /// Headline: what the agent noticed.
  summary        String
  /// Why it matters to this business.
  rationale      String
  /// The concrete next step, phrased so it can become an objective verbatim.
  proposal       String
  /// open | accepted | dismissed | snoozed
  status         String       @default("open")
  /// Set when the next step is the owner's to take (connect_integration | change_permission), not a goal for the agent.
  ownerAction    String?
  /// Set while snoozed; the list treats a lapsed snooze as open again.
  snoozedUntil   DateTime?
  acceptedAt     DateTime?
  acceptedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([agentId, status])
  @@index([actionItemId])
}

/// Something an agent wrote but did not send: a blog post, a social caption,
/// an email. `draft_content` only ever writes these; `publish_post` and
/// `send_email` are what move one out of the door, and those wait for a human.
model Draft {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  actionItemId   String?
  actionItem     ActionItem?  @relation(fields: [actionItemId], references: [id], onDelete: SetNull)
  /// blog_post | social_caption | email
  kind           String
  title          String
  body           String
  /// kind-specific: { subject, to } for email, { platform } for a caption.
  metadata       Json?
  /// draft | published | sent
  status         String       @default("draft")
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([agentId])
}

/// An outside system an organisation has connected. `webhook` is the generic
/// Zapier-style connector `publish_post` sends drafts to; `email` is the
/// provider `send_email` uses. Secrets are encrypted at rest with the vault
/// key and scoped to the organisation; nothing may ever write them to a log
/// or an audit row.
model Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// webhook | email
  type           String
  name           String
  /// Non-secret settings only (a from-address, a display host). Anything that
  /// grants access lives in `secret`.
  config         Json
  /// The vault ciphertext of the secret settings: endpoint URL, signing
  /// secret, API key. Decrypted only inside lib/work/integrations.ts.
  secret         String?
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, type])
}

/// Who did what to which thing. Written for every side-effecting action an
/// agent or a person takes; queryable per organisation and per target.
/// `organizationId` is nullable only for events with no tenant yet (sign-up).
model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // user | agent | system | schedule
  actorType      String
  actorId        String?
  // Dotted verb, e.g. organization.created, agent.published, tool.called.
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
  @@index([actorType, actorId])
}

/// Per-organisation token usage, bucketed by calendar month, provider, model
/// and agent. Incremented on every model call; billing reads from it.
/// `agentId` and `model` are "" rather than null so they can take part in the
/// unique key (NULLs are never equal in a unique index on Postgres).
model UsageCounter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// YYYY-MM, UTC.
  period         String
  provider       String
  model          String       @default("")
  agentId        String       @default("")
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  calls          Int          @default(0)
  /// Web searches and pages read, recorded under provider "search" so plan
  /// quotas can meter research alongside tokens.
  searches       Int          @default(0)
  pagesRead      Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, period, provider, model, agentId])
  @@index([organizationId, period])
}

/// Web search results by normalised query, shared across organisations: the
/// results are public data, the summaries written from them are not. Keeps
/// two agents asking the same question in the same hour to one API call.
model SearchCache {
  id        String   @id @default(cuid())
  /// provider + normalised query.
  key       String   @unique
  provider  String
  query     String
  /// SearchHit[]
  hits      Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

/// Proof that the background job runtime is alive. The scheduled heartbeat
/// function writes one row per tick; the health check reads the newest. A
/// silently dead scheduler is the worst failure this product can have, so it
/// is measured from day one.
model Heartbeat {
  id        String   @id @default(cuid())
  source    String   // inngest function id
  runId     String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

/// One fixed rate-limit window, shared by every server instance: the counter
/// lives in the database, not in one process's memory, so a limit means the
/// same thing on one instance or twenty.
model RateLimitWindow {
  /// bucket:subject, e.g. "org-model:<organizationId>" or "signup:<ip>".
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// One chat in the team room: the owner and all their agents. Kept, so the
/// owner can come back to it from the chat history.
model TeamThread {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The opening message, cut short: how the chat is listed in the history.
  title     String
  createdAt DateTime      @default(now())
  /// Moved on every message, so the history lists the latest chat first.
  updatedAt DateTime      @default(now())
  messages  TeamMessage[]

  @@index([projectId, updatedAt])
}

/// A line in a team chat. A person's line has no agentId; an agent's reply has
/// one, and links the task it started when the owner asked for work.
model TeamMessage {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  threadId     String
  thread       TeamThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  agentId      String?
  agent        Agent?      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// The person who wrote it; null on an agent's reply.
  userId       String?
  authorName   String?
  content      String
  actionItemId String?
  actionItem   ActionItem? @relation(fields: [actionItemId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([threadId, createdAt])
}

/// A blog post, announcement, patch note or news item published by the platform owner.
model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  /// blog | patch_notes | announcement | news
  category    String   @default("blog")
  summary     String?
  content     String
  /// published | draft
  status      String   @default("published")
  pinned      Boolean  @default(false)
  tags        String?
  authorName  String?
  authorEmail String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category, status])
}

// ---------------------------------------------------------------------------
// Life context (lib/life/*): the one shared picture of a person's life that
// every agent and the chat read from and write to. Every row is scoped to the
// personal space's project, carries where it came from (`source`), and is only
// ever written through lib/life/store.ts so each change is audited.
// ---------------------------------------------------------------------------

/// A calendar entry: meeting, event, trip, appointment. Mirrors an external
/// calendar when `externalId` is set; `source` says who put it here.
model LifeEvent {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  startsAt   DateTime
  endsAt     DateTime?
  allDay     Boolean  @default(false)
  location   String?
  /// meeting | trip | appointment | other
  kind       String   @default("other")
  status     String   @default("confirmed") // confirmed | tentative | cancelled
  /// user | agent:<id> | google | outlook | chat
  source     String   @default("user")
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId, startsAt])
}

/// A money fact: a spend, an income, or a bill. Slips, invoices and CSV rows
/// all become one of these, with the line items and the source image kept.
model LifeEntry {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// expense | income | bill
  kind       String
  payee      String
  /// Minor units (satang/cents) so sums never drift.
  amountMinor Int
  currency   String   @default("THB")
  category   String?
  /// When it happened (expense/income) or is due (bill).
  occurredAt DateTime
  /// bills only: unpaid | paid | overdue
  status     String?
  lineItems  Json?
  /// slip | invoice | csv | manual | agent:<id>
  source     String   @default("manual")
  /// Document id or stored image the entry was read from.
  sourceRef  String?
  createdAt  DateTime @default(now())

  @@index([projectId, occurredAt])
  @@index([projectId, kind, status])
}

/// A task, reminder or deadline.
model LifeTask {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  /// task | reminder | deadline
  kind      String   @default("task")
  dueAt     DateTime?
  status    String   @default("open") // open | done | dropped
  source    String   @default("user")
  externalId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status, dueAt])
}

/// What the person is working toward, in any domain.
model LifeGoal {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  /// money | fitness | travel | career | learning | other
  domain     String   @default("other")
  /// Minor units for money goals, otherwise the goal's own unit; free text says which.
  target     String?
  deadline   DateTime?
  status     String   @default("active") // active | done | dropped
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId, status])
}

/// A planned or finished workout session.
model LifeWorkout {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  scheduledAt DateTime
  durationMin Int?
  status      String   @default("planned") // planned | done | skipped
  notes       String?
  source      String   @default("user")
  createdAt   DateTime @default(now())

  @@index([projectId, scheduledAt])
}

/// A standing preference ("no meetings before 10", "monthly budget 30000").
model LifePreference {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
}

/// Recent interaction history and conclusions an agent or the engine wants
/// remembered ("trip to Chiang Mai blows June budget"). Short, dated, readable.
model LifeNote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// chat | agent:<id> | engine
  source    String
  text      String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

/// A proactive alert already sent (a bill due, a clash, a workout), so the same one is never sent twice.
model LifeAlertSent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@unique([projectId, key])
}
