# ---------------------------------------------------------------------------
# Roster - environment configuration
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- REQUIRED ---------------------------------------------------------------

# Anthropic API key. Used server-side only; never reaches the client bundle.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Secret used to sign Auth.js session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Database connection string.
#   postgresql -> postgresql://roster:roster@localhost:5432/roster?schema=public
#   sqlite     -> file:./roster.db
DATABASE_URL=postgresql://roster:roster@localhost:5432/roster?schema=public

# Which Prisma datasource to generate. Must match DATABASE_URL above.
#   postgresql -> full pgvector similarity search (server / cloud / docker compose)
#   sqlite     -> in-process cosine similarity (single-user Tauri desktop demo)
DATABASE_PROVIDER=postgresql


# --- OPTIONAL ---------------------------------------------------------------

# Public origin of this deployment. Used to build the shareable chat link and
# the <script> embed snippet. Falls back to the incoming request's origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only needed if ANTHROPIC_API_KEY is an organisation-level key rather than one
# scoped to a single workspace. An unscoped key is rejected with a 400 telling
# you to send this. Find the id in the Anthropic Console under
# Settings -> Workspaces (it looks like wrkspc_...). Leave blank for a
# workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=

# Default model for agents whose `model` field is null.
# Verified against https://docs.claude.com model list.
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# Embedding backend for RAG.
#   openai -> OpenAI text-embedding-3-small (1536 dims). Requires OPENAI_API_KEY.
#   local  -> deterministic hashed bag-of-words embedding, no network, no key.
# Retrieval is hybrid (keyword BM25 + vector cosine), so `local` still returns
# useful results - `openai` mainly improves paraphrase/synonym matching.
EMBEDDING_PROVIDER=local

# Required when EMBEDDING_PROVIDER=openai, or when an agent's modelProvider is
# set to "openai". Unused otherwise.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# Where uploaded context documents are written by the local-disk storage driver.
STORAGE_DIR=./storage

# Where to send a notification when a conversation escalates or a critical issue
# is logged. Comma-separated for more than one. Slack's incoming-webhook format
# is used, which Teams, Discord and most email relays also accept.
# Leave blank to disable notifications.
NOTIFY_WEBHOOK_URLS=

# Public chat rate limit: max messages per client session per window.
CHAT_RATE_LIMIT=20
CHAT_RATE_LIMIT_WINDOW_MS=60000

# --- AUTONOMOUS WORK ---------------------------------------------------------
# web_research needs a search API. Brave is used first (own index, cheapest
# per query; free tier at https://brave.com/search/api), Tavily second
# (https://tavily.com). Without a key the tool is unavailable and agents say
# so in their reports. Results are cached for 6 hours and every search is
# metered per organisation next to token usage.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# send_email falls back to these when an organisation has not connected its
# own email integration. Resend only, for now. EMAIL_FROM must be on a domain
# verified in the Resend account.
RESEND_API_KEY=
EMAIL_FROM=

# Model prices for the Insights cost figure, USD per million tokens. Anthropic
# models are built in; add or override any model here.
#   {"gpt-4o": {"input": 2.5, "output": 10}}
MODEL_PRICING_JSON=

# --- BACKGROUND JOBS (Inngest) ---------------------------------------------
# Scheduled and event-triggered work (the heartbeat now, autonomous agents
# later) runs through Inngest functions served at /api/inngest.
#
# Local development: set INNGEST_DEV=1 and run `npm run inngest:dev` alongside
# `npm run dev`. The dev server discovers the functions and fires their crons;
# its dashboard is at http://localhost:8288.
INNGEST_DEV=1
# Production: leave INNGEST_DEV unset and add the keys from the Inngest Cloud
# app settings. The signing key authenticates Inngest's calls to /api/inngest;
# the event key lets this app send events.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
