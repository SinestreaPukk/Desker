# ---------------------------------------------------------------------------
# Roster - environment configuration
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- REQUIRED ---------------------------------------------------------------

# Anthropic API key. Used server-side only; never reaches the client bundle.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Secret used to sign Auth.js session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Database connection string.
#   postgresql -> postgresql://roster:roster@localhost:5432/roster?schema=public
#   sqlite     -> file:./roster.db
DATABASE_URL=postgresql://roster:roster@localhost:5432/roster?schema=public

# Which Prisma datasource to generate. Must match DATABASE_URL above.
#   postgresql -> full pgvector similarity search (server / cloud / docker compose)
#   sqlite     -> in-process cosine similarity (local development)
DATABASE_PROVIDER=postgresql


# --- OPTIONAL ---------------------------------------------------------------

# Public origin of this deployment. Used to build the shareable chat link and
# the <script> embed snippet. Falls back to the incoming request's origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only needed if ANTHROPIC_API_KEY is an organisation-level key rather than one
# scoped to a single workspace. An unscoped key is rejected with a 400 telling
# you to send this. Find the id in the Anthropic Console under
# Settings -> Workspaces (it looks like wrkspc_...). Leave blank for a
# workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=

# Default model for agents whose `model` field is null.
# Verified against https://docs.claude.com model list.
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# Embedding backend for RAG.
#   openai -> OpenAI text-embedding-3-small (1536 dims). Requires OPENAI_API_KEY.
#   local  -> deterministic hashed bag-of-words embedding, no network, no key.
# Retrieval is hybrid (keyword BM25 + vector cosine), so `local` still returns
# useful results - `openai` mainly improves paraphrase/synonym matching.
EMBEDDING_PROVIDER=local

# Required when EMBEDDING_PROVIDER=openai, or when an agent's modelProvider is
# set to "openai". Unused otherwise.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# Where uploaded context documents are written by the local-disk storage driver.
STORAGE_DIR=./storage

# Where to send a notification when a conversation escalates or a critical issue
# is logged. Comma-separated for more than one. Slack's incoming-webhook format
# is used, which Teams, Discord and most email relays also accept.
# Leave blank to disable notifications.
NOTIFY_WEBHOOK_URLS=

# Public chat rate limit: max messages per client session per window.
# Blanket API requests per client address per minute (src/proxy.ts)
API_RATE_LIMIT=600
CHAT_RATE_LIMIT=20
CHAT_RATE_LIMIT_WINDOW_MS=60000
# Sign-ups per client address per ten minutes.
SIGNUP_RATE_LIMIT=20

# --- SHARED CAPACITY (fairness, not billing) ------------------------------------
# Plan limits cap what an organisation pays for; these cap how fast one
# organisation may draw on capacity every other organisation shares. Counted
# in the database, so they hold however many instances are running.
# Model calls on demand (chat, previews, drafts, digests) per organisation per minute.
ORG_MODEL_CALLS_PER_MINUTE=120
# Runs started by a person or a webhook per organisation per minute. Scheduled
# runs are never refused - the job runtime throttles them to this rate instead.
ORG_RUNS_PER_MINUTE=30
# Autonomous runs executing at once across the whole platform. Size it to the
# model provider's rate limit and the database's connection pool.
WORK_MAX_CONCURRENT_RUNS=50
# A run still going after this long is reported to its owner; at 4x it is ended.
RUN_TIME_BUDGET_MS=900000
# Platform alerts (queue backlog, failure or escalation spikes, many runs over
# budget) also go here: a Slack-compatible incoming webhook for whoever runs Desker.
OPS_ALERT_WEBHOOK_URL=

# --- AUTONOMOUS WORK ---------------------------------------------------------
# web_research needs a search API. Brave is used first (own index, cheapest
# per query; free tier at https://brave.com/search/api), Tavily second
# (https://tavily.com). Without a key the tool is unavailable and agents say
# so in their reports. Results are cached for 6 hours and every search is
# metered per organisation next to token usage.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# send_email falls back to these when an organisation has not connected its
# own email integration. Resend only, for now. EMAIL_FROM must be on a domain
# verified in the Resend account.
RESEND_API_KEY=
EMAIL_FROM=
# Where the public contact form is emailed (falls back to content/site.json).
CONTACT_EMAIL=

# Model prices for the Insights cost figure, USD per million tokens. Anthropic
# models are built in; add or override any model here.
#   {"gpt-4o": {"input": 2.5, "output": 10}}
MODEL_PRICING_JSON=

# --- CREDENTIAL VAULT --------------------------------------------------------
# Encrypts integration secrets (webhook URLs and signing secrets, email API
# keys) at rest. Required before any integration can be connected.
# Generate with: openssl rand -base64 32
# Losing it means every integration has to be reconnected - keep it safe.
VAULT_KEY=

# --- SIGN-IN APPS FOR CONNECTORS (OAuth) ----------------------------------------
# One app per provider for the whole deployment; each organisation's tokens are
# separate and sealed with VAULT_KEY. Callback for each provider:
#   https://<your domain>/api/integrations/oauth/callback/<google|microsoft|slack|github>
# Leave a pair empty and its connectors say "not set up on this server".
# Google: Gmail (gmail.readonly, gmail.compose) and Google Calendar (calendar.events).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra (multitenant + personal accounts): Outlook mail and calendar
# through Graph - Mail.ReadWrite, Mail.Send, Calendars.ReadWrite, offline_access.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Slack: bot scopes chat:write, channels:read.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Plaid (bank accounts for the Money Manager): dashboard.plaid.com > Keys.
# PLAID_ENV is sandbox (fake banks), development or production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US,GB,CA
# GitHub: a GitHub App (read-only contents, issues, pull requests); the slug is
# the part after github.com/apps/.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Social networks (each is its own developer app; callbacks are
# <NEXT_PUBLIC_APP_URL>/api/integrations/oauth/callback/<linkedin|meta|x|threads>)
# LinkedIn: products "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: the LinkedIn API version (YYYYMM) once the default is retired.
LINKEDIN_API_VERSION=
# Meta (Facebook Pages + Instagram business accounts): Facebook Login for Business.
META_APP_ID=
META_APP_SECRET=
# X: OAuth 2.0, confidential client, read and write.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Threads: the Threads use case of a Meta app has its own app id and secret.
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- BILLING (Stripe) --------------------------------------------------------
# Plan limits are enforced only when billing exists: with no Stripe key the
# deployment is "self-hosted" and unlimited. Set ENFORCE_PLAN_LIMITS=true to
# enforce the free tier without Stripe (used by the tests).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price ids (recurring, monthly) for the paid tiers in lib/billing/plans.ts.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
ENFORCE_PLAN_LIMITS=

# --- BACKGROUND JOBS (Inngest) ---------------------------------------------
# Scheduled and event-triggered work (the heartbeat now, autonomous agents
# later) runs through Inngest functions served at /api/inngest.
#
# Local development: set INNGEST_DEV=1 and run `npm run inngest:dev` alongside
# `npm run dev`. The dev server discovers the functions and fires their crons;
# its dashboard is at http://localhost:8288.
INNGEST_DEV=1
# Production: leave INNGEST_DEV unset and add the keys from the Inngest Cloud
# app settings. The signing key authenticates Inngest's calls to /api/inngest;
# the event key lets this app send events.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
# Distinguishes deployments sharing one Inngest environment (staging vs prod).
INNGEST_APP_ID=desker

# --- MONITORING ---------------------------------------------------------------
# Sentry. Leave blank to disable. The public DSN is safe in the browser; the
# auth token (source-map upload) is build-time only.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Shown in error reports and as a banner in the app: "staging" or "production".
NEXT_PUBLIC_ENVIRONMENT=

# --- LEGAL -------------------------------------------------------------------
# Rendered into the Terms and Privacy pages.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_JURISDICTION=

# Private beta: only these addresses may sign in or create an account
# (comma-separated). Leave unset to let anyone in.
ALLOWED_SIGNIN_EMAILS=
